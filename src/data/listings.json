{
  "_schema": {
    "_description": "Listings data for the plots discovery platform. Replace the sample listings below with real data. Keep every field; the UI reads all of them.",
    "listing": {
      "id": "unique slug, e.g. 'emerald-enclave-shadnagar'",
      "title": "display name of the plot project",
      "venture": "venture or layout name the plot belongs to",
      "developer": "developer or builder name",
      "state": "Telangana | Karnataka | Tamil Nadu",
      "city": "Hyderabad | Bengaluru | Chennai",
      "locality": "must match a key in the localities object",
      "lat": "latitude as a number",
      "lng": "longitude as a number",
      "price": "total price in INR as a number, no commas",
      "sizeSqYd": "plot size in square yards as a number",
      "pricePerSqYd": "price per square yard in INR as a number",
      "approvals": "array, any of: DTCP, HMDA, RERA, CMDA, BMRDA, BDA",
      "facing": "East | West | North | South | North-East | North-West | South-East | South-West",
      "plotShape": "square | rectangle | irregular",
      "vastuFriendly": "true when facing is East/North and shape is square/rectangle",
      "amenities": "array of amenity names",
      "status": "available | few-left | sold-out",
      "description": "2-3 sentence marketing description, no em-dashes",
      "landmarks": {
        "highway": { "name": "e.g. NH-44", "distanceKm": 1.2 },
        "school": { "name": "school name", "distanceKm": 2.0 },
        "hospital": { "name": "hospital name", "distanceKm": 3.5 },
        "railwayStation": { "name": "station name", "distanceKm": 4.0 }
      }
    },
    "locality": {
      "city": "city name",
      "state": "state name",
      "priceTrend": "array of 12 numbers: avg price per sq. yd. for the last 12 months, oldest first, newest last. Shown as a sparkline on detail pages.",
      "trendNote": "one line describing the trend, updated when data changes"
    }
  },
