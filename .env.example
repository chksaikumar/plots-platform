# Copy this file to .env and fill in your Firebase web app config.
# Get the values from Firebase console > Project settings > Your apps > Web app.
# If these are left empty, the site runs on the local sample data in src/data/listings.json.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
